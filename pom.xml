       <!-- [2. 영문 상세 주석] -->
       <!-- 💡 [Urgent Fix] Dependency injection of Caffeine cache for OOM defense network. Repaired the Maven Central resolution rupture caused by a typo in the GroupID ('benmanes' -> 'ben-manes'). -->
       <!-- [3. XML 코드] -->
       <dependency>
           <groupId>com.github.ben-manes.caffeine</groupId>
           <artifactId>caffeine</artifactId>
